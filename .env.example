VITE_API_URL=http://localhost:5000/api
# Public Google OAuth 2.0 Web Client ID for Google Identity Services (must match backend GOOGLE_CLIENT_ID).
# Configure Authorized JavaScript origins in Google Cloud Console (e.g. http://localhost:5173 for local dev
# and the exact HTTPS frontend origin in staging/production). Never place a Google Client Secret in frontend env vars.
VITE_GOOGLE_CLIENT_ID=
